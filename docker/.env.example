# Browser entry port. The gateway is bound to 127.0.0.1 only.
# Change it when 8080 is already in use, for example: DZZ_HTTP_PORT=18080
DZZ_HTTP_PORT=8080

# MariaDB initial credentials. Replace all default passwords before exposing
# the service outside local development. Do not change MYSQL_DATABASE or
# MYSQL_USER after an existing runtime/mariadb directory has been initialized.
MYSQL_ROOT_PASSWORD=dzzoffice
MYSQL_DATABASE=dzzoffice
MYSQL_USER=dzzoffice
MYSQL_PASSWORD=dzzoffice

# Shared by DzzOffice's ONLYOFFICE plugin and Document Server. Generate a new
# value for every non-local deployment, for example:
# openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=3184dc51c33e4094268e4b278675fc2fada67911ef93d2b1fa5956c1b1581fa4

# Optional Dzz login protection for /apps/fileview/ and /apps/onlyoffice/.
#
# off (default): backwards-compatible mode. No Dzz session check is made by
#                the gateway; only the Docker internal-network boundary applies.
# dzz-authcheck:  gateway forwards the browser's Dzz login Cookie to
#                index.php?mod=gateway&op=authcheck before proxying. Anonymous
#                requests receive 401 and never reach the third-party service.
#
# Leave this disabled for an unmodified or old DzzOffice installation. Enable
# it only after the dzz/gateway/authcheck.php source change has been installed.
DZZ_GATEWAY_AUTH_MODE=off

# Required only when DZZ_GATEWAY_AUTH_MODE=dzz-authcheck. Use a different,
# high-entropy value from ONLYOFFICE_JWT_SECRET; generate one with:
# openssl rand -hex 32
# The same value is injected into both app and gateway containers. Do not add
# quotes around the value and never commit a production .env file.
DZZ_GATEWAY_AUTH_SECRET=
